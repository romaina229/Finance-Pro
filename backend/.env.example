APP_NAME="ONG Finance Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ong_finance_pro
DB_USERNAME=postgres
DB_PASSWORD=

# --- Sanctum / Auth ---
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
SESSION_DOMAIN=localhost

# --- Stockage fichiers (S3 / Supabase Storage) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Redis (queues, cache) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mobile Money (à compléter par opérateur) ---
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MOOV_MONEY_API_KEY=
ORANGE_MONEY_API_KEY=
